[Unit]
Description=AgroPilot registry-service (farms, plots, catalogues; public on 8000)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=agropilot
Group=agropilot
WorkingDirectory=/opt/agropilot/app/services/registry-service
ExecStart=/opt/agropilot/app/services/registry-service/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
