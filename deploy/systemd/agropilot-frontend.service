[Unit]
Description=AgroPilot frontend (Next.js production server; public on 3000)
After=network-online.target agropilot-planner.service
Wants=network-online.target agropilot-planner.service

[Service]
Environment=NODE_ENV=production
User=agropilot
Group=agropilot
WorkingDirectory=/opt/agropilot/app/services/frontend
ExecStart=/opt/agropilot/app/services/frontend/node_modules/.bin/next start --hostname 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
