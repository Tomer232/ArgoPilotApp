[Unit]
Description=AgroPilot planner-service (daily irrigation plan; local only)
After=network-online.target agropilot-registry.service agropilot-weather.service
Wants=network-online.target agropilot-registry.service agropilot-weather.service

[Service]
User=agropilot
Group=agropilot
WorkingDirectory=/opt/agropilot/app/services/planner-service
ExecStart=/opt/agropilot/app/services/planner-service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
