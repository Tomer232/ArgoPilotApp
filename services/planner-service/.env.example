# Copy this file to .env and fill it in. .env is never committed.

# Where the other two services answer.
REGISTRY_URL=http://127.0.0.1:8000
WEATHER_URL=http://127.0.0.1:8001

# How long to wait for each answer. The weather timeout is longer than weather-service's
# own worst case (3 attempts x 3 s + pauses, about 10 s), so its stale answer still arrives.
REGISTRY_TIMEOUT_SECONDS=2
WEATHER_TIMEOUT_SECONDS=12
