# Copy this file to .env and fill it in. .env is never committed.

# The forecast provider (Open-Meteo). A paid plan uses a customer-... URL and a key.
PROVIDER_BASE_URL=https://api.open-meteo.com/v1/forecast
PROVIDER_API_KEY=

# One attempt gives up after this many seconds; then up to PROVIDER_RETRIES more attempts,
# with a short pause between them.
PROVIDER_TIMEOUT_SECONDS=3
PROVIDER_RETRIES=2
PROVIDER_RETRY_PAUSE_SECONDS=0.5

# A forecast younger than FRESH_HOURS is served without calling the provider.
# When the provider fails, a forecast up to MAX_STALE_HOURS old is served with "stale": true.
FRESH_HOURS=3
MAX_STALE_HOURS=24
