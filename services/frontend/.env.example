# Copy this file to .env.local and fill it in. .env.local is never committed.
# Only the Next.js server reads these; the browser never calls the services.

# Where the three services answer.
REGISTRY_URL=http://127.0.0.1:8000
WEATHER_URL=http://127.0.0.1:8001
PLANNER_URL=http://127.0.0.1:8002

# How long to wait for each answer. The planner timeout is longer than the planner's
# own worst case (registry 2 s per call + weather 12 s), so its 503 still arrives.
REGISTRY_TIMEOUT_SECONDS=2
PLANNER_TIMEOUT_SECONDS=20
HEALTH_TIMEOUT_SECONDS=2
