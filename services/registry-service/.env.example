# Copy this file to .env and fill it in. .env is never committed.

# Local development: the SQLite file registry.db in this folder.
DATABASE_URL=sqlite:///registry.db

# Production: the PostgreSQL database "registry". Use this line instead of the one above.
# DATABASE_URL=postgresql+psycopg://registry:CHANGE_ME@localhost:5432/registry?connect_timeout=3&options=-c%20statement_timeout%3D5000

# Optional: run the test suite against PostgreSQL. Never point this at "registry": tests drop every table.
# TEST_DATABASE_URL=postgresql+psycopg://registry:CHANGE_ME@localhost:5432/registry_test?connect_timeout=3&options=-c%20statement_timeout%3D5000
